# DDLnzb Bridge configuration

## Core API settings
# Die API-URL bringt der Bridge selbst mit. Ueberschreibbar, z. B. mit
# http://api:8000 im Docker-Netzwerk oder http://localhost:8000 lokal.
DDLNZB_API_URL=https://ddlnzb.pages.dev/api/app
# Pflicht. Ohne Key lehnt der Bridge jeden Aufruf ab (auch /api der
# *arr-Apps). Kann alternativ ueber die Web-Oberflaeche gesetzt werden.
DDLNZB_API_KEY=

## Bridge server
# BRIDGE_HOST/BRIDGE_PORT gelten nur fuer lokale Laeufe. Im Docker-Image
# setzt das CMD den Port fest auf 6789.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8080
BRIDGE_LOG_LEVEL=INFO

## JDownloader credentials
MYJD_EMAIL=
MYJD_PASSWORD=
MYJD_DEVICE_NAME=
MYJD_APP_KEY=DDLnzb

## Download destinations
DOWNLOAD_DIR=./downloads
EXTRACT_ARCHIVES=true
DELETE_ARCHIVES=true

## Optional category mapping overrides (JSON string)
# CATEGORY_MAPPING={"movies":"Movies","tv":"TV"}

## Persistence
# Queue und Historie
DDLNZB_STATE_FILE=./ddlnzb_bridge_state.json
# Ablage der Queue-Datei und der Settings-Datei der Web-Oberflaeche
DDLNZB_DATA_DIR=./data
# Einzelner Pfad fuer die Settings-Datei der Web-Oberflaeche
# DDLNZB_SETTINGS_FILE=./data/settings.json

## Ersteinrichtung
# Setup-Token fuer die Web-Oberflaeche, wenn kein API-Key gesetzt ist.
# Ohne diesen Wert wird beim Start ein Token erzeugt und im Log ausgegeben
# (docker logs ddlnzb-bridge | grep "Setup-Token").
# DDLNZB_SETUP_TOKEN=
