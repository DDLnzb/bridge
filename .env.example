# DDLnzb Bridge configuration

## Core API settings
# The bridge ships with its own API URL. Can be overridden, e.g. with
# http://api:8000 inside the Docker network or http://localhost:8000 locally.
DDLNZB_API_URL=https://ddlnzb.pages.dev/api/app
# Required. Without a key the bridge rejects every call (including /api of the
# *arr apps). Can alternatively be set via the web UI.
DDLNZB_API_KEY=

## Bridge server
# BRIDGE_HOST/BRIDGE_PORT only apply to local runs. In the Docker image
# the CMD pins the port to 6789.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8080
BRIDGE_LOG_LEVEL=INFO

## CORS
# The bridge needs no CORS: the *arr apps are not browsers and the web UI is
# served from the same origin as the API. The default is an empty allowlist -
# a foreign origin then gets no CORS header at all.
# Comma separated list of origins, only if the UI is operated from another
# origin. This is an environment-only setting: the settings file of the web UI
# cannot change it.
# BRIDGE_CORS_ORIGINS=https://ui.example

## JDownloader credentials
MYJD_EMAIL=
MYJD_PASSWORD=
MYJD_DEVICE_NAME=
MYJD_APP_KEY=DDLnzb

## Download destinations
DOWNLOAD_DIR=./downloads
EXTRACT_ARCHIVES=true
DELETE_ARCHIVES=true

## Optional category mapping overrides (JSON string)
# CATEGORY_MAPPING={"movies":"Movies","tv":"TV"}

## Persistence
# Queue and history
DDLNZB_STATE_FILE=./ddlnzb_bridge_state.json
# Location of the queue file and of the web UI settings file
DDLNZB_DATA_DIR=./data
# Individual path for the web UI settings file
# DDLNZB_SETTINGS_FILE=./data/settings.json

## Initial setup
# Setup token for the web UI, used when no API key is set.
# Without this value a token is generated at startup and printed to the log
# (docker logs ddlnzb-bridge | grep "Setup-Token").
# DDLNZB_SETUP_TOKEN=
